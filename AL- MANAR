    <script>
        // Data artikel (disimpan di memori, bisa dikembangkan ke localStorage)
        let daftarArtikel = [];

        // Toggle maskot info
        function toggleMaskot() {
            const info = document.getElementById('maskotInfo');
            const bubble = document.getElementById('speechBubble');
            const maskot = document.getElementById('maskot');
            info.classList.toggle('show');
            maskot.classList.toggle('active');
            
            if (info.classList.contains('show')) {
                bubble.textContent = "Ini informasi tentang pesantren! 👇";
            } else {
                bubble.textContent = "Assalamu'alaikum! Ada yang bisa saya bantu?";
            }
        }

        // Switch tab
        function switchTab(tab) {
            const beranda = document.getElementById('page-beranda');
            const operator = document.getElementById('page-operator');
            const navBtns = document.querySelectorAll('.nav-btn');

            navBtns.forEach(btn => btn.classList.remove('active'));

            if (tab === 'beranda') {
                beranda.style.display = 'block';
                operator.style.display = 'none';
                navBtns[0].classList.add('active');
            } else {
                beranda.style.display = 'none';
                operator.style.display = 'block';
                navBtns[1].classList.add('active');
                renderDaftarOperator();
            }
        }

        // Tambah artikel
        function tambahArtikel() {
            const judul = document.getElementById('inputJudul').value.trim();
            const kategori = document.getElementById('inputKategori').value;
            const penulis = document.getElementById('inputPenulis').value.trim() || 'Redaksi AL-MANAR';
            const cuplikan = document.getElementById('inputCuplikan').value.trim();
            const isi = document.getElementById('inputIsi').value.trim();

            if (!judul || !cuplikan) {
                alert('Judul dan cuplikan wajib diisi!');
                return;
            }

            const artikelBaru = {
                id: Date.now(),
                judul: judul,
                kategori: kategori,
                penulis: penulis,
                cuplikan: cuplikan,
                isi: isi || cuplikan,
                tanggal: new Date().toLocaleDateString('id-ID', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric'
                })
            };

            daftarArtikel.unshift(artikelBaru);
            renderArtikel();
            renderDaftarOperator();
            resetForm();
            alert('✅ Artikel berhasil dipublikasikan!');
        }

        // Reset form
        function resetForm() {
            document.getElementById('inputJudul').value = '';
            document.getElementById('inputKategori').value = 'Berita Pesantren';
            document.getElementById('inputPenulis').value = '';
            document.getElementById('inputCuplikan').value = '';
            document.getElementById('inputIsi').value = '';
        }

        // Render artikel di beranda
        function renderArtikel() {
            const grid = document.getElementById('artikelGrid');
            
            if (daftarArtikel.length === 0) {
                grid.innerHTML = `
                    <div class="empty-state" id="emptyState">
                        <div class="icon">📝</div>
                        <p>Belum ada artikel yang dipublikasikan.</p>
                        <small>Operator dapat menambahkan artikel melalui Panel Operator.</small>
                    </div>
                `;
                return;
            }

            grid.innerHTML = daftarArtikel.map(a => `
                <div class="artikel-card">
                    <div class="kategori">${a.kategori}</div>
                    <h3>${escapeHtml(a.judul)}</h3>
                    <div class="meta">✍️ ${escapeHtml(a.penulis)} · 📅 ${a.tanggal}</div>
                    <div class="cuplikan">${escapeHtml(a.cuplikan)}</div>
                    <button class="baca-btn" onclick="bacaArtikel(${a.id})">Baca Selengkapnya →</button>
                </div>
            `).join('');
        }

        // Baca artikel (tampilkan isi lengkap dalam alert/modal sederhana)
        function bacaArtikel(id) {
            const artikel = daftarArtikel.find(a => a.id === id);
            if (artikel) {
                alert(`📰 ${artikel.judul}\n\n${artikel.kategori} | ${artikel.penulis} | ${artikel.tanggal}\n\n${artikel.isi}`);
            }
        }

        // Render daftar artikel di panel operator
        function renderDaftarOperator() {
            const container = document.getElementById('daftarArtikelOperator');
            
            if (daftarArtikel.length === 0) {
                container.innerHTML = '<p style="color:#8ab89a; font-size:0.8rem;">Belum ada artikel.</p>';
                return;
            }

            container.innerHTML = daftarArtikel.map(a => `
                <div class="artikel-list-item">
                    <div class="judul-item">
                        ${escapeHtml(a.judul)}
                        <small>${a.kategori} · ${a.tanggal}</small>
                    </div>
                    <button class="btn-danger" onclick="hapusArtikel(${a.id})">Hapus</button>
                </div>
            `).join('');
        }

        // Hapus artikel
        function hapusArtikel(id) {
            if (confirm('Yakin ingin menghapus artikel ini?')) {
                daftarArtikel = daftarArtikel.filter(a => a.id !== id);
                renderArtikel();
                renderDaftarOperator();
            }
        }

