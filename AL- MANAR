        <div class="hero-stats">
          <div><strong>2016</strong><span>Berdiri</span></div>
          <div><strong>310+</strong><span>Santri</span></div>
          <div><strong>28</strong><span>Hafidz 30 Juz</span></div>
        </div>
      </div>

      <!-- MASKOT MANAR -->
      <div class="hero-maskot">
        <div class="maskot-wrapper" id="maskotWrapper">
          <div class="maskot-bubble" id="maskotBubble">
            <span id="maskotText">Assalamu'alaikum! Saya Manar, siap membawa kabar dari Pesantren Almadani Cikalong. 📰</span>
          </div>

