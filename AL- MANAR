            <path d="M108 88 Q116 83 124 88" stroke="#3d2b1f" stroke-width="3.5" fill="none" stroke-linecap="round"/>
            <!-- Mata -->
            <circle cx="84" cy="100" r="7" fill="white"/>
            <circle cx="116" cy="100" r="7" fill="white"/>
            <circle cx="85" cy="101" r="3.5" fill="#1a1a1a"/>
