<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AL-MANAR — Jurnalistik Pesantren Al-Madani Cikalong</title>
<style>
  /* ========== RESET & VARIABEL ========== */
  * { margin: 0; padding: 0; box-sizing: border-box; }
  :root {
    --hijau-tua: #0d3b1e;
    --hijau-muda: #1e6b3a;
    --krem: #f5e6c8;
    --emas: #d4a843;
    --piksel-bg: #0a1f12;
    --teks-terang: #e8dfc8;
    --font-utama: 'Courier New', Courier, monospace;
  }

  /* ========== PIXEL BACKGROUND (CSS only) ========== */
  body {
    font-family: var(--font-utama);
    background-color: var(--piksel-bg);
    color: var(--teks-terang);
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
    image-rendering: pixelated;
  }

  /* Lapisan pixel pattern */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(30, 107, 58, 0.15) 1px, transparent 1px),
      linear-gradient(90deg, rgba(30, 107, 58, 0.15) 1px, transparent 1px),
      radial-gradient(circle at 20% 30%, rgba(212, 168, 67, 0.06) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(30, 107, 58, 0.1) 0%, transparent 50%);
    background-size: 16px 16px, 16px 16px, 100% 100%, 100% 100%;
    pointer-events: none;
    z-index: 0;
  }

  /* Efek “bintang pixel” berkedip */
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      radial-gradient(2px 2px at 10% 20%, rgba(212,168,67,0.5) 50%, transparent 50%),
      radial-gradient(2px 2px at 90% 15%, rgba(212,168,67,0.4) 50%, transparent 50%),
      radial-gradient(2px 2px at 50% 80%, rgba(212,168,67,0.3) 50%, transparent 50%),
      radial-gradient(2px 2px at 75% 45%, rgba(212,168,67,0.4) 50%, transparent 50%),
      radial-gradient(2px 2px at 25% 65%, rgba(212,168,67,0.3) 50%, transparent 50%);
    background-size: 200px 200px;
    animation: blink 4s infinite alternate;
    pointer-events: none;
    z-index: 0;
  }
  @keyframes blink {
    0% { opacity: 0.4; }
    100% { opacity: 1; }
  }

  /* ========== LAYOUT ========== */
  .container {
    position: relative;
    z-index: 1;
    max-width: 960px;
    margin: 0 auto;
    padding: 20px 16px 80px;
  }

  /* ========== HEADER ========== */
  header {
    text-align: center;
    padding: 32px 0 16px;
    border-bottom: 4px double var(--emas);
    margin-bottom: 24px;
    position: relative;
  }
  header h1 {
    font-size: clamp(2rem, 6vw, 3.2rem);
    letter-spacing: 6px;
    color: var(--emas);
    text-shadow: 3px 3px 0 var(--hijau-tua), 0 0 20px rgba(212,168,67,0.3);
    font-weight: 700;
  }
  header .tagline {
    font-size: 0.8rem;
    color: var(--krem);
    letter-spacing: 2px;
    margin-top: 6px;
    opacity: 0.8;
  }
  .header-deco {
    font-size: 0.7rem;
    color: var(--hijau-muda);
    margin-top: 4px;
    letter-spacing: 4px;
  }

  /* ========== NAVIGASI ========== */
  nav {
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  nav button {
    background: var(--hijau-tua);
    color: var(--krem);
    border: 2px solid var(--hijau-muda);
    padding: 8px 18px;
    font-family: var(--font-utama);
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.15s;
    image-rendering: pixelated;
    box-shadow: 2px 2px 0 #061a0e;
  }
  nav button:hover {
    background: var(--hijau-muda);
    border-color: var(--emas);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 #061a0e;
  }
  nav button.active {
    background: var(--emas);
    color: var(--hijau-tua);
    border-color: var(--emas);
    font-weight: bold;
  }

  /* ========== SECTION ========== */
  .section { display: none; }
  .section.active { display: block; animation: fadeIn 0.3s ease; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  /* ========== KARTU ARTIKEL ========== */
  .artikel-grid { display: flex; flex-direction: column; gap: 16px; }
  .artikel-card {
    background: rgba(13, 59, 30, 0.85);
    border: 2px solid var(--hijau-muda);
    padding: 18px 20px;
    box-shadow: 4px 4px 0 #061a0e;
    transition: border-color 0.2s;
    position: relative;
  }
  .artikel-card:hover { border-color: var(--emas); }
  .artikel-card .kategori {
    display: inline-block;
    background: var(--emas);
    color: var(--hijau-tua);
    font-size: 0.65rem;
    padding: 2px 8px;
    font-weight: bold;
    letter-spacing: 1px;
    margin-bottom: 8px;
  }
  .artikel-card h3 {
    color: var(--krem);
    font-size: 1.05rem;
    margin-bottom: 6px;
  }
  .artikel-card .meta {
    font-size: 0.65rem;
    color: #8faa8f;
    margin-bottom: 8px;
  }
  .artikel-card .ringkasan {
    font-size: 0.8rem;
    color: #c4d4c4;
    line-height: 1.6;
  }
  .artikel-card .aksi {
    margin-top: 10px;
    display: flex;
    gap: 8px;
  }
  .artikel-card .aksi button {
    background: transparent;
    border: 1px solid var(--hijau-muda);
    color: var(--krem);
    font-family: var(--font-utama);
    font-size: 0.65rem;
    padding: 4px 10px;
    cursor: pointer;
  }
  .artikel-card .aksi button:hover { border-color: var(--emas); color: var(--emas); }
  .artikel-card .aksi button.hapus:hover { border-color: #c44; color: #e66; }

  /* ========== FORM ========== */
  .form-group { margin-bottom: 14px; }
  .form-group label {
    display: block;
    font-size: 0.75rem;
    color: var(--emas);
    margin-bottom: 4px;
    letter-spacing: 1px;
  }
  .form-group input,
  .form-group textarea,
  .form-group select {
    width: 100%;
    background: #0a1f12;
    border: 2px solid var(--hijau-muda);
    color: var(--krem);
    font-family: var(--font-utama);
    font-size: 0.8rem;
    padding: 10px 12px;
    outline: none;
  }
  .form-group input:focus,
  .form-group textarea:focus,
  .form-group select:focus { border-color: var(--emas); }
  .form-group textarea { min-height: 120px; resize: vertical; }

  .btn-utama {
    background: var(--emas);
    color: var(--hijau-tua);
    border: 2px solid var(--emas);
    font-family: var(--font-utama);
    font-weight: bold;
    font-size: 0.8rem;
    padding: 10px 24px;
    cursor: pointer;
    box-shadow: 3px 3px 0 #061a0e;
    transition: all 0.1s;
    letter-spacing: 1px;
  }
  .btn-utama:hover { background: #e8c060; transform: translate(-1px,-1px); box-shadow: 4px 4px 0 #061a0e; }
  .btn-utama:active { transform: translate(2px,2px); box-shadow: 0 0 0 #061a0e; }

  .btn-batal {
    background: transparent;
    color: #8faa8f;
    border: 2px solid #2a4a2a;
    font-family: var(--font-utama);
    font-size: 0.8rem;
    padding: 10px 24px;
    cursor: pointer;
  }

  /* ========== ALMA MASKOT (Q版像素风) ========== */
  .alma-wrapper {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 100;
    cursor: pointer;
    filter: drop-shadow(0 4px 12px rgba(0,0,0,0.6));
    transition: transform 0.2s;
    user-select: none;
  }
  .alma-wrapper:hover { transform: scale(1.08); }

  /* Alma digambar sepenuhnya dengan CSS pixel-art style */
  .alma {
    width: 80px;
    height: 96px;
    position: relative;
    image-rendering: pixelated;
  }
  /* Peci (topi) */
  .alma .peci {
    width: 52px;
    height: 18px;
    background: #1a1a2e;
    position: absolute;
    top: 0;
    left: 14px;
    border-radius: 4px 4px 0 0;
    border: 2px solid #2a2a4e;
    box-shadow: inset 0 -3px 0 #0a0a1e;
  }
  .alma .peci::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 4px;
    width: 44px;
    height: 4px;
    background: #d4a843;
  }
  /* Kepala */
  .alma .kepala {
    width: 60px;
    height: 56px;
    background: #f0d0a0;
    border-radius: 8px;
    position: absolute;
    top: 16px;
    left: 10px;
    border: 2px solid #c8a878;
    box-shadow: inset 0 -4px 0 #e0c090;
  }
  /* Kacamata */
  .alma .kacamata {
    position: absolute;
    top: 36px;
    left: 16px;
    width: 48px;
    height: 14px;
    display: flex;
    gap: 4px;
    align-items: center;
  }
  .alma .lensa {
    width: 20px;
    height: 14px;
    background: rgba(100, 180, 255, 0.5);
    border: 3px solid #2a2a2a;
    border-radius: 3px;
    box-shadow: inset 0 0 4px rgba(100,180,255,0.6);
  }
  .alma .jembatan {
    width: 4px;
    height: 3px;
    background: #2a2a2a;
  }
  /* Mata (di belakang lensa) */
  .alma .mata {
    position: absolute;
    width: 4px;
    height: 4px;
    background: #1a1a1a;
    border-radius: 50%;
    top: 41px;
  }
  .alma .mata-kiri { left: 24px; }
  .alma .mata-kanan { left: 48px; }
  /* Mulut */
  .alma .mulut {
    position: absolute;
    width: 10px;
    height: 4px;
    background: #c06060;
    border-radius: 0 0 6px 6px;
    top: 56px;
    left: 35px;
  }
  /* Badan */
  .alma .badan {
    width: 56px;
    height: 30px;
    background: #f5f5f5;
    position: absolute;
    top: 70px;
    left: 12px;
    border: 2px solid #ccc;
    border-radius: 4px 4px 6px 6px;
  }
  .alma .badan::after {
    content: 'AL-MANAR';
    position: absolute;
    font-size: 4px;
    font-family: monospace;
    color: #1e6b3a;
    top: 10px;
    left: 6px;
    letter-spacing: 0.5px;
  }
  /* Tangan */
  .alma .tangan-kiri, .alma .tangan-kanan {
    width: 10px;
    height: 18px;
    background: #f0d0a0;
    border: 2px solid #c8a878;
    border-radius: 4px;
    position: absolute;
    top: 72px;
  }
  .alma .tangan-kiri { left: 0; }
  .alma .tangan-kanan { right: 0; }

  /* Gelembung dialog Alma */
  .alma-bubble {
    position: fixed;
    bottom: 130px;
    right: 20px;
    max-width: 260px;
    background: var(--krem);
    color: var(--hijau-tua);
    border: 3px solid var(--emas);
    padding: 12px 16px;
    font-family: var(--font-utama);
    font-size: 0.72rem;
    line-height: 1.5;
    box-shadow: 4px 4px 0 #061a0e;
    z-index: 101;
    display: none;
    border-radius: 8px 8px 0 8px;
  }
  .alma-bubble.show { display: block; animation: popIn 0.25s ease; }
  .alma-bubble::after {
    content: '';
    position: absolute;
    bottom: -12px;
    right: 24px;
    border-left: 10px solid transparent;
    border-right: 0 solid transparent;
    border-top: 12px solid var(--emas);
  }
  .alma-bubble .tutup {
    position: absolute;
    top: 4px;
    right: 8px;
    cursor: pointer;
    font-weight: bold;
    font-size: 0.8rem;
    color: #8f6a20;
  }
  @keyframes popIn {
    from { opacity: 0; transform: scale(0.85) translateY(8px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  /* ========== ADMIN PANEL ========== */
  .admin-toggle {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 100;
    background: var(--hijau-tua);
    border: 2px solid var(--emas);
    color: var(--emas);
    font-family: var(--font-utama);
    font-size: 0.7rem;
    padding: 6px 14px;
    cursor: pointer;
    box-shadow: 2px 2px 0 #061a0e;
  }
  .admin-toggle:hover { background: var(--emas); color: var(--hijau-tua); }

  .admin-panel {
    display: none;
    background: rgba(13, 59, 30, 0.95);
    border: 2px solid var(--emas);
    padding: 20px;
    margin-bottom: 24px;
    box-shadow: 4px 4px 0 #061a0e;
  }
  .admin-panel.show { display: block; }
  .admin-panel h3 {
    color: var(--emas);
    font-size: 0.9rem;
    margin-bottom: 14px;
    letter-spacing: 2px;
    border-bottom: 1px solid var(--hijau-muda);
    padding-bottom: 8px;
  }

  /* ========== KOSONG ========== */
  .kosong {
    text-align: center;
    padding: 48px 16px;
    color: #5a7a5a;
    font-size: 0.8rem;
    border: 2px dashed #2a4a2a;
  }
  .kosong .ikon { font-size: 2rem; margin-bottom: 8px; }

  /* ========== TENTANG ========== */
  .tentang-box {
    background: rgba(13, 59, 30, 0.85);
    border: 2px solid var(--hijau-muda);
    padding: 24px;
    line-height: 1.8;
    font-size: 0.82rem;
    color: #c4d4c4;
    box-shadow: 4px 4px 0 #061a0e;
  }
  .tentang-box h2 {
    color: var(--emas);
    font-size: 1rem;
    margin-bottom: 12px;
    letter-spacing: 2px;
  }
  .tentang-box .highlight {
    color: var(--emas);
    font-weight: bold;
  }
  .tentang-box ul {
    margin: 10px 0 10px 20px;
    list-style: square;
  }
  .tentang-box ul li { margin-bottom: 6px; }

  /* ========== DETAIL ARTIKEL ========== */
  .detail-artikel {
    background: rgba(13, 59, 30, 0.9);
    border: 2px solid var(--emas);
    padding: 28px 24px;
    box-shadow: 4px 4px 0 #061a0e;
  }
  .detail-artikel h2 {
    color: var(--emas);
    font-size: 1.2rem;
    margin-bottom: 8px;
    line-height: 1.4;
  }
  .detail-artikel .meta {
    font-size: 0.7rem;
    color: #8faa8f;
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--hijau-muda);
  }
  .detail-artikel .isi {
    font-size: 0.85rem;
    line-height: 1.9;
    color: #d4e4d4;
    white-space: pre-wrap;
  }
  .detail-artikel .kembali {
    display: inline-block;
    margin-top: 20px;
    color: var(--emas);
    cursor: pointer;
    font-size: 0.75rem;
    border-bottom: 1px dashed var(--emas);
  }

  /* ========== RESPONSIF ========== */
  @media (max-width: 600px) {
    .alma { width: 64px; height: 78px; transform: scale(0.8); transform-origin: bottom right; }
    .alma-bubble { max-width: 200px; font-size: 0.65rem; bottom: 110px; }
    .admin-toggle { top: 8px; right: 8px; font-size: 0.6rem; padding: 4px 10px; }
  }
</style>
</head>
<body>

<!-- ===== ADMIN TOGGLE ===== -->
<button class="admin-toggle" onclick="toggleAdmin()">⚙ OPERATOR</button>

<!-- ===== ALMA MASKOT ===== -->
<div class="alma-bubble" id="almaBubble">
  <span class="tutup" onclick="sembunyikanAlma()">✕</span>
  <div id="almaText">Assalamu‘alaikum! Saya Alma, maskot AL-MANAR. Klik saya untuk info pesantren!</div>
</div>

<div class="alma-wrapper" onclick="klikAlma()" title="Klik Alma untuk info">
  <div class="alma">
    <div class="peci"></div>
    <div class="kepala"></div>
    <div class="mata mata-kiri"></div>
    <div class="mata mata-kanan"></div>
    <div class="kacamata">
      <div class="lensa"></div>
      <div class="jembatan"></div>
      <div class="lensa"></div>
    </div>
    <div class="mulut"></div>
    <div class="badan"></div>
    <div class="tangan-kiri"></div>
    <div class="tangan-kanan"></div>
  </div>
</div>

<!-- ===== KONTEN UTAMA ===== -->
<div class="container">

  <header>
    <h1>AL-MANAR</h1>
    <div class="tagline">JURNALISTIK PESANTREN AL-MADANI CIKALONG</div>
    <div class="header-deco">✦ CAHAYA INFORMASI SANTRI ✦</div>
  </header>

  <nav>
    <button class="active" onclick="switchTab('beranda', this)">BERANDA</button>
    <button onclick="switchTab('tentang', this)">TENTANG</button>
    <button onclick="switchTab('kelola', this)">KELOLA ARTIKEL</button>
  </nav>

  <!-- ===== SECTION BERANDA ===== -->
  <div class="section active" id="section-beranda">
    <div class="artikel-grid" id="daftarArtikel">
      <!-- Artikel akan di-render oleh JS -->
    </div>
  </div>

  <!-- ===== SECTION DETAIL (hidden, muncul saat klik baca) ===== -->
  <div class="section" id="section-detail">
    <div class="detail-artikel">
      <h2 id="detailJudul"></h2>
      <div class="meta" id="detailMeta"></div>
      <div class="isi" id="detailIsi"></div>
      <span class="kembali" onclick="switchTab('beranda', document.querySelector('nav button'))">← Kembali ke Beranda</span>
    </div>
  </div>

  <!-- ===== SECTION TENTANG ===== -->
  <div class="section" id="section-tentang">
    <div class="tentang-box">
      <h2>▸ TENTANG AL-MANAR</h2>
      <p><span class="highlight">AL-MANAR</span> adalah kanal jurnalistik resmi bagian jurnalistik Pesantren Al-Madani Cikalong, Majalengka. Nama “Al-Manar” berarti “cahaya” atau “menara pencerahan” — mencerminkan misi kami untuk menyampaikan informasi yang terang, akurat, dan bermanfaat bagi santri, wali santri, dan masyarakat luas.</p>
      <br>
      <h2>▸ PESANTREN AL-MADANI CIKALONG</h2>
      <p>Pondok Pesantren Al-Madani Cikalong berdiri pada <span class="highlight">4 Juni 2016 (1 Ramadhan 1438 H)</span> di Desa Cikalong, Kecamatan Sukahaji, Kabupaten Majalengka, Jawa Barat.</p>
      <ul>
        <li><span class="highlight">Program unggulan:</span> Tahfizul Qur‘an yang dilaksanakan secara intensif sejak kelas 3 SMP [citation:2].</li>
        <li><span class="highlight">Ekstrakurikuler:</span> Pencak silat Merpati Putih, drumband, senam, <span class="highlight">jurnalis</span>, bahasa, dan pramuka [citation:4].</li>
        <li><span class="highlight">Bahasa:</span> Arab digunakan sebagai bahasa utama komunikasi dan pembelajaran [citation:3].</li>
        <li><span class="highlight">Jumlah santri:</span> ±310 orang pada tahun ajaran 2024–2025 [citation:3].</li>
        <li><span class="highlight">Manajemen:</span> Menerapkan strategi digital berbasis teknologi informasi dalam pembelajaran dan pengelolaan sumber daya [citation:12].</li>
      </ul>
      <br>
      <p style="font-size:0.7rem; color:#6a8a6a; border-top:1px solid #2a4a2a; padding-top:12px;">AL-MANAR dikelola oleh Divisi Jurnalistik Pesantren Al-Madani Cikalong. Seluruh konten artikel dapat dikelola secara manual oleh operator melalui panel di pojok kanan atas.</p>
    </div>
  </div>

  <!-- ===== SECTION KELOLA (ADMIN) ===== -->
  <div class="section" id="section-kelola">
    <div class="admin-panel show" style="display:block; margin-bottom:0;">
      <h3 id="formTitle">▸ TAMBAH ARTIKEL BARU</h3>
      <input type="hidden" id="editId" value="">
      <div class="form-group">
        <label>JUDUL ARTIKEL</label>
        <input type="text" id="inputJudul" placeholder="Contoh: Kegiatan Jurnalis Santri Al-Madani">
      </div>
      <div class="form-group">
        <label>KATEGORI</label>
        <select id="inputKategori">
          <option value="BERITA">BERITA</option>
          <option value="KEGIATAN">KEGIATAN</option>
          <option value="PRESTASI">PRESTASI</option>
          <option value="OPINI">OPINI</option>
          <option value="PENGUMUMAN">PENGUMUMAN</option>
        </select>
      </div>
      <div class="form-group">
        <label>PENULIS / REPORTER</label>
        <input type="text" id="inputPenulis" placeholder="Nama santri / operator">
      </div>
      <div class="form-group">
        <label>RINGKASAN SINGKAT (tampil di beranda)</label>
        <textarea id="inputRingkasan" style="min-height:60px;" placeholder="Satu atau dua kalimat ringkasan..."></textarea>
      </div>
      <div class="form-group">
        <label>ISI ARTIKEL LENGKAP</label>
        <textarea id="inputIsi" placeholder="Tulis isi artikel di sini..."></textarea>
      </div>
      <div style="display:flex; gap:12px; flex-wrap:wrap;">
        <button class="btn-utama" onclick="simpanArtikel()">💾 SIMPAN ARTIKEL</button>
        <button class="btn-batal" onclick="resetForm()">BATAL</button>
      </div>
    </div>

    <div style="margin-top:24px;">
      <h3 style="color:var(--emas); font-size:0.85rem; letter-spacing:2px; margin-bottom:12px;">▸ DAFTAR ARTIKEL TERSIMPAN</h3>
      <div id="daftarKelola" class="artikel-grid"></div>
    </div>
  </div>

</div>

<!-- ===== SCRIPT ===== -->
<script>
/* ============================================================
   DATA & STORAGE
   ============================================================ */
const STORAGE_KEY = 'almanar_artikel';

function ambilArtikel() {
  try {
    const data = localStorage.getItem(STORAGE_KEY);
    return data ? JSON.parse(data) : [];
  } catch { return []; }
}

function simpanKeStorage(arr) {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(arr));
}

/* ============================================================
   RENDER BERANDA
   ============================================================ */
function renderBeranda() {
  const list = ambilArtikel();
  const container = document.getElementById('daftarArtikel');
  if (list.length === 0) {
    container.innerHTML = `
      <div class="kosong">
        <div class="ikon">📰</div>
        Belum ada artikel.<br>Operator dapat menambahkan artikel melalui menu <strong>KELOLA ARTIKEL</strong>.
      </div>`;
    return;
  }
  // Urutkan terbaru di atas
  const sorted = [...list].reverse();
  container.innerHTML = sorted.map(a => `
    <div class="artikel-card">
      <span class="kategori">${a.kategori || 'BERITA'}</span>
      <h3>${escapeHtml(a.judul)}</h3>
      <div class="meta">${a.penulis || 'Redaksi AL-MANAR'} · ${a.tanggal || '-'}</div>
      <div class="ringkasan">${escapeHtml(a.ringkasan || '')}</div>
      <div class="aksi">
        <button onclick="bacaArtikel('${a.id}')">BACA SELENGKAPNYA →</button>
      </div>
    </div>
  `).join('');
}

function bacaArtikel(id) {
  const list = ambilArtikel();
  const a = list.find(x => x.id === id);
  if (!a) return;
  document.getElementById('detailJudul').textContent = a.judul;
  document.getElementById('detailMeta').textContent = `${a.kategori} · ${a.penulis || 'Redaksi'} · ${a.tanggal}`;
  document.getElementById('detailIsi').textContent = a.isi;
  // Sembunyikan semua, tampilkan detail
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.getElementById('section-detail').classList.add('active');
  // Update nav active state
  document.querySelectorAll('nav button').forEach(b => b.classList.remove('active'));
  document.querySelector('nav button').classList.add('active');
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

