/* ========== RESET & VARIABEL ========== */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --hijau-tua: #1a3a2a;
  --hijau: #2d5a3d;
  --hijau-muda: #3d7a52;
  --emas: #c9a84c;
  --emas-muda: #e0c878;
  --krem: #faf8f0;
  --krem-tua: #f0ead6;
  --putih: #ffffff;
  --hitam: #1a1a1a;
  --abu: #6b7280;
  --shadow: 0 4px 20px rgba(26, 58, 42, 0.1);
  --shadow-hover: 0 8px 30px rgba(26, 58, 42, 0.18);
}

body {
  font-family: 'Inter', sans-serif;
  background: var(--krem);
  color: var(--hitam);
  line-height: 1.6;
  overflow-x: hidden;
}

h1, h2, h3, h4 {
  font-weight: 700;
  line-height: 1.2;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}

/* ========== NAVBAR ========== */
.navbar {
  background: var(--hijau-tua);
  position: sticky;
  top: 0;
  z-index: 1000;
  box-shadow: 0 2px 20px rgba(0,0,0,0.15);
}

.nav-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 12px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo-area {
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo-icon {
  font-size: 2rem;
  background: var(--emas);
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
}

.logo-text {
  color: var(--emas);
  font-size: 1.5rem;
  letter-spacing: 2px;
  font-family: 'Amiri', serif;
}

.logo-sub {
  color: rgba(255,255,255,0.7);
  font-size: 0.7rem;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.nav-links {
  display: flex;
  list-style: none;
  gap: 8px;
  align-items: center;
}

.nav-links a {
  color: rgba(255,255,255,0.85);
  text-decoration: none;
  padding: 10px 18px;
  border-radius: 8px;
  font-weight: 500;
  font-size: 0.9rem;
  transition: all 0.3s;
}

.nav-links a:hover,
.nav-links a.active {
  background: rgba(201, 168, 76, 0.2);
  color: var(--emas-muda);
}

.btn-operator {
  background: var(--emas);
  color: var(--hijau-tua) !important;
  font-weight: 700 !important;
}

.btn-operator:hover {
  background: var(--emas-muda) !important;
}

.hamburger {
  display: none;
  color: white;
  font-size: 1.8rem;
  cursor: pointer;
}

/* ========== HERO ========== */
.hero {
  background: linear-gradient(135deg, var(--hijau-tua) 0%, var(--hijau) 60%, #1f4a32 100%);
  position: relative;
  padding: 80px 0 60px;
  overflow: hidden;
}

.hero-bg-pattern {
  position: absolute;
  inset: 0;
  background-image: 
    radial-gradient(circle at 20% 30%, rgba(201,168,76,0.08) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(201,168,76,0.06) 0%, transparent 50%);
  pointer-events: none;
}

.hero-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: center;
  position: relative;
  z-index: 2;
}

.badge-jurnalis {
  display: inline-block;
  background: rgba(201, 168, 76, 0.2);
  color: var(--emas-muda);
  padding: 8px 18px;
  border-radius: 50px;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 1px;
  margin-bottom: 20px;
  border: 1px solid rgba(201,168,76,0.3);
}

.hero-title {
  font-size: 3.2rem;
  color: white;
  margin-bottom: 20px;
  font-weight: 800;
}

.hero-title .highlight {
  color: var(--emas);
}

.hero-desc {
  color: rgba(255,255,255,0.8);
  font-size: 1.05rem;
  margin-bottom: 30px;
  max-width: 520px;
}

.hero-actions {
  display: flex;
  gap: 14px;
  margin-bottom: 40px;
}

.btn-primary {
  display: inline-block;
  background: var(--emas);
  color: var(--hijau-tua);
  padding: 14px 32px;
  border-radius: 10px;
  font-weight: 700;
  text-decoration: none;
  border: none;
  cursor: pointer;
  font-size: 0.95rem;
  transition: all 0.3s;
}

.btn-primary:hover {
  background: var(--emas-muda);
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(201,168,76,0.4);
}

.btn-outline {
  display: inline-block;
  background: transparent;
  color: var(--emas);
  padding: 14px 32px;
  border-radius: 10px;
  font-weight: 600;
  text-decoration: none;
  border: 2px solid var(--emas);
  transition: all 0.3s;
}

.btn-outline:hover {
  background: var(--emas);
  color: var(--hijau-tua);
}

.hero-stats {
  display: flex;
  gap: 36px;
}

.hero-stats div {
  display: flex;
  flex-direction: column;
}

.hero-stats strong {
  color: var(--emas);
  font-size: 1.8rem;
  font-weight: 800;
}

.hero-stats span {
  color: rgba(255,255,255,0.6);
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 1px;
}

/* ========== MASKOT ========== */
.hero-maskot {
  display: flex;
  justify-content: center;
  position: relative;
}

.maskot-wrapper {
  position: relative;
  animation: floatMaskot 4s ease-in-out infinite;
}

@keyframes floatMaskot {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-14px); }
}

.maskot-svg {
  width: 280px;
  height: auto;
  filter: drop-shadow(0 12px 24px rgba(0,0,0,0.3));
}

.maskot-shadow {
  width: 160px;
  height: 20px;
  background: rgba(0,0,0,0.2);
  border-radius: 50%;
  margin: -10px auto 0;
  filter: blur(6px);
  animation: shadowPulse 4s ease-in-out infinite;
}

@keyframes shadowPulse {
  0%, 100% { transform: scaleX(1); opacity: 0.25; }
  50% { transform: scaleX(0.85); opacity: 0.15; }
}

.maskot-bubble {
  position: absolute;
  top: -20px;
  right: -120px;
  background: white;
  padding: 14px 20px;
  border-radius: 16px;
  max-width: 260px;
  font-size: 0.85rem;
  color: var(--hijau-tua);
  box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  line-height: 1.5;
  animation: bubbleIn 0.6s ease;
  border-left: 4px solid var(--emas);
}

.maskot-bubble::after {
  content: '';
  position: absolute;
  bottom: -8px;
  left: 30px;
  width: 0;
  height: 0;
  border-left: 8px solid transparent;
  border-right: 8px solid transparent;
  border-top: 10px solid white;
}

@keyframes bubbleIn {
  from { opacity: 0; transform: translateY(10px) scale(0.95); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

/* ========== SECTION HEADER ========== */
.section-header {
  text-align: center;
  margin-bottom: 48px;
}

.section-header h2 {
  font-size: 2rem;
  color: var(--hijau-tua);
  margin-bottom: 10px;
}

.section-header p {
  color: var(--abu);
  font-size: 1rem;
  max-width: 600px;
  margin: 0 auto;
}

/* ========== ARTIKEL ========== */
.artikel-section {
  padding: 80px 0;
  background: var(--putih);
}

.artikel-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: 28px;
}

.artikel-empty {
  grid-column: 1 / -1;
  text-align: center;
  padding: 60px 30px;
  background: var(--krem);
  border-radius: 20px;
  border: 2px dashed rgba(45, 90, 61, 0.2);
}

.empty-icon {
  font-size: 4rem;
  margin-bottom: 16px;
}

.artikel-empty h3 {
  color: var(--hijau-tua);
  font-size: 1.4rem;
  margin-bottom: 8px;
}

.artikel-empty p {
  color: var(--abu);
  margin-bottom: 20px;
}

/* Kartu Artikel */
.artikel-card {
  background: var(--putih);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: var(--shadow);
  transition: all 0.3s;
  border: 1px solid rgba(45,90,61,0.08);
  display: flex;
  flex-direction: column;
  animation: cardIn 0.5s ease;
}

@keyframes cardIn {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

.artikel-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-hover);
}

.card-header {
  padding: 20px 24px 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-kategori {
  background: var(--hijau);
  color: white;
  padding: 4px 12px;
  border-radius: 50px;
  font-size: 0.7rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.card-tanggal {
  font-size: 0.75rem;
  color: var(--abu);
}

.card-body {
  padding: 16px 24px 24px;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.card-body h3 {
  font-size: 1.2rem;
  color: var(--hijau-tua);
  margin-bottom: 10px;
  line-height: 1.35;
}

.card-ringkasan {
  color: var(--abu);
  font-size: 0.9rem;
  margin-bottom: 16px;
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 14px;
  border-top: 1px solid rgba(0,0,0,0.06);
}

.card-penulis {
  font-size: 0.8rem;
  color: var(--abu);
  font-style: italic;
}

.btn-baca {
  background: transparent;
  color: var(--hijau);
  border: 1.5px solid var(--hijau);
  padding: 6px 16px;
  border-radius: 8px;
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s;
}

.btn-baca:hover {
  background: var(--hijau);
  color: white;
}

.btn-hapus {
  background: transparent;
  color: #c0392b;
  border: none;
  font-size: 1.1rem;
  cursor: pointer;
  padding: 4px 8px;
  border-radius: 6px;
  transition: background 0.2s;
}

.btn-hapus:hover {
  background: rgba(192, 57, 43, 0.1);
}

/* ========== TENTANG ========== */
.tentang-section {
  padding: 80px 0;
  background: var(--krem);
}

.tentang-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 24px;
}

.tentang-card {
  background: white;
  padding: 32px 28px;
  border-radius: 16px;
  box-shadow: var(--shadow);
  border-top: 4px solid var(--emas);
  transition: transform 0.3s;
}

.tentang-card:hover {
  transform: translateY(-4px);
}

.tentang-card h3 {
  color: var(--hijau-tua);
  margin-bottom: 12px;
  font-size: 1.15rem;
}

.tentang-card p {
  color: var(--abu);
  font-size: 0.92rem;
}

/* ========== OPERATOR ========== */
.operator-section {
  padding: 80px 0;
  background: var(--putih);
}

.form-artikel {
  max-width: 800px;
  margin: 0 auto;
  background: var(--krem);
  padding: 36px;
  border-radius: 20px;
  border: 1px solid rgba(45,90,61,0.1);
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 20px;
}

.form-group {
  display: flex;
  flex-direction: column;
  margin-bottom: 20px;
}

.form-group label {
  font-weight: 600;
  font-size: 0.85rem;
  color: var(--hijau-tua);
  margin-bottom: 8px;
}

.form-group input,
.form-group select,
.form-group textarea {
  padding: 12px 16px;
  border: 1.5px solid rgba(45,90,61,0.15);
  border-radius: 10px;
  font-family: 'Inter', sans-serif;
  font-size: 0.95rem;
  background: white;
  transition: border-color 0.3s, box-shadow 0.3s;
  resize: vertical;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  outline: none;
  border-color: var(--hijau);
  box-shadow: 0 0 0 3px rgba(45,90,61,0.1);
}

.btn-full {
  width: 100%;
  padding: 16px;
  font-size: 1rem;
}

/* ========== FOOTER ========== */
.footer {
  background: var(--hijau-tua);
  color: rgba(255,255,255,0.8);
  padding: 60px 0 0;
}

.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 40px;
  padding-bottom: 40px;
  border-bottom: 1px solid rgba(255,255,255,0.1);
}

.footer h3 {
  color: var(--emas);
  font-size: 1.4rem;
  margin-bottom: 12px;
  font-family: 'Amiri', serif;
  letter-spacing: 2px;
}

.footer h4 {
  color: white;
  font-size: 1rem;
  margin-bottom: 14px;
}

.footer p {
  font-size: 0.88rem;
  line-height: 1.7;
}

.footer ul {
  list-style: none;
}

.footer ul li {
  margin-bottom: 8px;
}

.footer ul a {
  color: rgba(255,255,255,0.7);
  text-decoration: none;
  font-size: 0.88rem;
  transition: color 0.3s;
}

.footer ul a:hover {
  color: var(--emas);
}

.footer-bottom {
  text-align: center;
  padding: 20px 0;
  font-size: 0.8rem;
  color: rgba(255,255,255,0.4);
}

/* ========== MODAL BACA ARTIKEL ========== */
.modal-overlay {
  display: none;
