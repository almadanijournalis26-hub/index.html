<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AL-MANAR — Jurnalistik Pesantren Al-Madani Cikalong</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', 'Poppins', system-ui, sans-serif;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(145deg, #0b2e1f 0%, #1a4a2e 40%, #2d6a4f 100%);
            position: relative;
            overflow-x: hidden;
        }

        /* ===== BACKGROUND ANIMASI ===== */
        .bg-animation {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
            overflow: hidden;
        }

        .bg-animation .circle {
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 215, 0, 0.06);
            animation: floatCircle 20s infinite ease-in-out;
        }

        .bg-animation .circle:nth-child(1) {
            width: 300px;
            height: 300px;
            top: -100px;
            left: -100px;
            animation-delay: 0s;
        }

        .bg-animation .circle:nth-child(2) {
            width: 500px;
            height: 500px;
            bottom: -200px;
            right: -150px;
            animation-delay: -5s;
            background: rgba(255, 215, 0, 0.04);
        }

        .bg-animation .circle:nth-child(3) {
            width: 200px;
            height: 200px;
            top: 40%;
            left: 70%;
            animation-delay: -10s;
            background: rgba(144, 238, 144, 0.05);
        }

        .bg-animation .circle:nth-child(4) {
            width: 150px;
            height: 150px;
            top: 15%;
            left: 50%;
            animation-delay: -15s;
            background: rgba(255, 255, 255, 0.04);
        }

        @keyframes floatCircle {
            0%, 100% { transform: translate(0, 0) scale(1); }
            25% { transform: translate(30px, -40px) scale(1.1); }
            50% { transform: translate(-20px, 20px) scale(0.95); }
            75% { transform: translate(40px, 30px) scale(1.05); }
        }

        /* Pola batik/arabesque halus */
        .bg-pattern {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
            opacity: 0.03;
            background-image: 
                repeating-linear-gradient(45deg, #ffd700 0px, #ffd700 2px, transparent 2px, transparent 12px),
                repeating-linear-gradient(-45deg, #ffd700 0px, #ffd700 2px, transparent 2px, transparent 12px);
        }

        /* ===== KONTEN UTAMA ===== */
        .main-wrapper {
            position: relative;
            z-index: 10;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px 40px;
        }

        /* HEADER */
        .header {
            text-align: center;
            padding: 30px 0 20px;
            position: relative;
        }

        .header h1 {
            font-size: 3.5rem;
            font-weight: 800;
            letter-spacing: 6px;
            color: #ffd700;
            text-shadow: 0 4px 20px rgba(255, 215, 0, 0.3), 0 0 40px rgba(255, 215, 0, 0.1);
            margin-bottom: 5px;
            animation: glowTitle 3s ease-in-out infinite alternate;
        }

        @keyframes glowTitle {
            from { text-shadow: 0 4px 20px rgba(255, 215, 0, 0.2); }
            to { text-shadow: 0 4px 30px rgba(255, 215, 0, 0.5), 0 0 60px rgba(255, 215, 0, 0.2); }
        }

        .header .subtitle {
            font-size: 0.95rem;
            color: #b8e0c8;
            letter-spacing: 2px;
            font-weight: 400;
            background: rgba(0, 0, 0, 0.2);
            display: inline-block;
            padding: 6px 24px;
            border-radius: 30px;
            border: 1px solid rgba(255, 215, 0, 0.2);
        }

        /* ===== MASKOT ANIMASI ===== */
        .maskot-section {
            display: flex;
            justify-content: center;
            align-items: flex-end;
            gap: 20px;
            margin: 20px 0 30px;
            flex-wrap: wrap;
        }

        .maskot-container {
            position: relative;
            cursor: pointer;
            transition: transform 0.3s;
            animation: maskotBounce 2.5s ease-in-out infinite;
        }

        @keyframes maskotBounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        .maskot-container:hover {
            animation-play-state: paused;
            transform: scale(1.05);
        }

        .maskot-svg {
            width: 140px;
            height: auto;
            filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.4));
        }

        /* Speech bubble */
        .speech-bubble {
            position: absolute;
            top: -50px;
            left: 50%;
            transform: translateX(-50%);
            background: #fff;
            color: #1a4a2e;
            padding: 10px 18px;
            border-radius: 16px;
            font-size: 0.8rem;
            font-weight: 600;
            white-space: nowrap;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            opacity: 0;
            transition: opacity 0.3s, transform 0.3s;
            pointer-events: none;
            border: 2px solid #ffd700;
        }

        .speech-bubble::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 0;
            height: 0;
            border-left: 10px solid transparent;
            border-right: 10px solid transparent;
            border-top: 10px solid #ffd700;
        }

        .maskot-container:hover .speech-bubble {
            opacity: 1;
            transform: translateX(-50%) translateY(-5px);
        }

        .maskot-container.active .speech-bubble {
            opacity: 1;
            transform: translateX(-50%) translateY(-5px);
        }

        /* Info panel maskot */
        .maskot-info {
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 215, 0, 0.3);
            border-radius: 20px;
            padding: 20px 28px;
            color: #e0f0e8;
            max-width: 400px;
            font-size: 0.85rem;
            line-height: 1.7;
            display: none;
            animation: fadeInUp 0.4s ease;
        }

        .maskot-info.show {
            display: block;
        }

        .maskot-info strong {
            color: #ffd700;
        }

        .maskot-info .highlight {
            color: #90ee90;
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ===== NAVIGASI ===== */
        .nav-bar {
            display: flex;
            justify-content: center;
            gap: 8px;
            flex-wrap: wrap;
            margin: 30px 0 40px;
        }

        .nav-btn {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 215, 0, 0.25);
            color: #d0e8d8;
            padding: 10px 24px;
            border-radius: 30px;
            cursor: pointer;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.3s;
            backdrop-filter: blur(5px);
        }

        .nav-btn:hover, .nav-btn.active {
            background: #ffd700;
            color: #0b2e1f;
            border-color: #ffd700;
            font-weight: 700;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 215, 0, 0.3);
        }

        /* ===== SECTION ARTIKEL ===== */
        .section-title {
            font-size: 1.6rem;
            color: #ffd700;
            margin-bottom: 24px;
            padding-bottom: 10px;
            border-bottom: 2px solid rgba(255, 215, 0, 0.3);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .section-title::before {
            content: '📰';
            font-size: 1.4rem;
        }

        .artikel-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 24px;
            margin-bottom: 40px;
        }

        .artikel-card {
            background: rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 215, 0, 0.15);
            border-radius: 20px;
            padding: 24px;
            transition: all 0.35s;
            position: relative;
            overflow: hidden;
        }

        .artikel-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(to bottom, #ffd700, #90ee90);
            border-radius: 4px 0 0 4px;
        }

        .artikel-card:hover {
            transform: translateY(-6px);
            border-color: rgba(255, 215, 0, 0.5);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3), 0 0 30px rgba(255, 215, 0, 0.1);
        }

        .artikel-card .kategori {
            display: inline-block;
            background: rgba(255, 215, 0, 0.15);
            color: #ffd700;
            font-size: 0.7rem;
            padding: 4px 12px;
            border-radius: 20px;
            margin-bottom: 12px;
            font-weight: 600;
            letter-spacing: 1px;
        }

        .artikel-card h3 {
            color: #ffffff;
            font-size: 1.1rem;
            margin-bottom: 10px;
            line-height: 1.4;
        }

        .artikel-card .meta {
            color: #8ab89a;
            font-size: 0.75rem;
            margin-bottom: 12px;
        }

        .artikel-card .cuplikan {
            color: #c8ddd0;
            font-size: 0.85rem;
            line-height: 1.6;
            margin-bottom: 16px;
        }

        .artikel-card .baca-btn {
            background: transparent;
            border: 1px solid rgba(255, 215, 0, 0.4);
            color: #ffd700;
            padding: 8px 20px;
            border-radius: 20px;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: 500;
        }

        .artikel-card .baca-btn:hover {
            background: #ffd700;
            color: #0b2e1f;
        }

        /* Empty state */
        .empty-state {
            grid-column: 1 / -1;
            text-align: center;
            padding: 60px 20px;
            background: rgba(255, 255, 255, 0.03);
            border: 2px dashed rgba(255, 215, 0, 0.2);
            border-radius: 20px;
            color: #8ab89a;
        }

        .empty-state .icon {
            font-size: 3rem;
            margin-bottom: 16px;
        }

        .empty-state p {
            font-size: 0.95rem;
            margin-bottom: 6px;
        }

        .empty-state small {
            font-size: 0.75rem;
            opacity: 0.6;
        }

        /* ===== PANEL OPERATOR ===== */
        .operator-panel {
            display: none;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 215, 0, 0.25);
            border-radius: 24px;
            padding: 32px;
            margin-bottom: 40px;
            animation: fadeInUp 0.4s ease;
        }

        .operator-panel.show {
            display: block;
        }

        .operator-panel h2 {
            color: #ffd700;
            font-size: 1.4rem;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            color: #b8e0c8;
            font-size: 0.8rem;
            margin-bottom: 6px;
            font-weight: 500;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 12px 16px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 215, 0, 0.2);
            border-radius: 12px;
            color: #ffffff;
            font-size: 0.9rem;
            transition: border-color 0.3s;
            font-family: inherit;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: #ffd700;
            background: rgba(255, 255, 255, 0.12);
        }

        .form-group textarea {
            min-height: 120px;
            resize: vertical;
        }

        .form-group select option {
            background: #1a4a2e;
            color: #fff;
        }

        .btn-group {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 24px;
        }

        .btn-primary {
            background: #ffd700;
            color: #0b2e1f;
            border: none;
            padding: 12px 32px;
            border-radius: 30px;
            font-weight: 700;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-primary:hover {
            background: #ffe44d;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 215, 0, 0.4);
        }

        .btn-secondary {
            background: transparent;
            color: #ffd700;
            border: 1px solid rgba(255, 215, 0, 0.4);
            padding: 12px 32px;
            border-radius: 30px;
            font-weight: 500;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-secondary:hover {
            background: rgba(255, 215, 0, 0.1);
        }

        .btn-danger {
            background: transparent;
            color: #ff6b6b;
            border: 1px solid rgba(255, 107, 107, 0.4);
            padding: 8px 18px;
            border-radius: 20px;
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-danger:hover {
            background: rgba(255, 107, 107, 0.15);
        }

        /* Daftar artikel di panel operator */
        .artikel-list-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 16px;
            background: rgba(255, 255, 255, 0.04);
            border-radius: 12px;
            margin-bottom: 8px;
            border: 1px solid rgba(255, 255, 255, 0.06);
            transition: background 0.2s;
        }

        .artikel-list-item:hover {
            background: rgba(255, 255, 255, 0.08);
        }

        .artikel-list-item .judul-item {
            color: #d0e8d8;
            font-size: 0.85rem;
            flex: 1;
            margin-right: 12px;
        }

        .artikel-list-item .judul-item small {
            color: #8ab89a;
            display: block;
            font-size: 0.7rem;
            margin-top: 2px;
        }

        /* ===== FOOTER ===== */
        .footer {
            text-align: center;
            padding: 40px 0 20px;
            border-top: 1px solid rgba(255, 215, 0, 0.15);
            margin-top: 40px;
        }

        .footer p {
            color: #8ab89a;
            font-size: 0.8rem;
            line-height: 1.8;
        }

        .footer .brand {
            color: #ffd700;
            font-weight: 700;
            letter-spacing: 2px;
        }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 768px) {
            .header h1 {
                font-size: 2.2rem;
                letter-spacing: 3px;
            }

            .header .subtitle {
                font-size: 0.75rem;
                padding: 5px 16px;
            }

            .maskot-svg {
                width: 110px;
            }

            .artikel-grid {
                grid-template-columns: 1fr;
            }

            .operator-panel {
                padding: 20px;
            }

            .speech-bubble {
                font-size: 0.7rem;
                padding: 8px 12px;
                white-space: normal;
                max-width: 160px;
                text-align: center;
            }
        }

        @media (max-width: 480px) {
            .header h1 {
                font-size: 1.8rem;
            }

            .nav-btn {
                padding: 8px 16px;
                font-size: 0.75rem;
            }
        }

        /* Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #0b2e1f;
        }

        ::-webkit-scrollbar-thumb {
            background: #ffd700;
            border-radius: 4px;
        }
    </style>
</head>
<body>

    <!-- Background Animasi -->
    <div class="bg-animation">
        <div class="circle"></div>
        <div class="circle"></div>
        <div class="circle"></div>
        <div class="circle"></div>
    </div>
    <div class="bg-pattern"></div>

    <div class="main-wrapper">

        <!-- HEADER -->
        <header class="header">
            <h1>AL-MANAR</h1>
            <div class="subtitle">Jurnalistik Pesantren Al-Madani Cikalong</div>
        </header>

        <!-- MASKOT -->
        <section class="maskot-section">
            <div class="maskot-container" id="maskot" onclick="toggleMaskot()">
                <div class="speech-bubble" id="speechBubble">Assalamu'alaikum! Ada yang bisa saya bantu?</div>
                <svg class="maskot-svg" viewBox="0 0 200 260" xmlns="http://www.w3.org/2000/svg">
                    <!-- Badan -->
                    <rect x="60" y="150" width="80" height="80" rx="15" fill="#2d6a4f" stroke="#1a4a2e" stroke-width="2"/>
                    <!-- Peci -->
                    <rect x="55" y="20" width="90" height="40" rx="8" fill="#1a1a1a" stroke="#333" stroke-width="2"/>
                    <rect x="55" y="20" width="90" height="40" rx="8" fill="url(#peciShine)" opacity="0.3"/>
                    <defs>
                        <linearGradient id="peciShine" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0%" stop-color="#fff" stop-opacity="0.6"/>
                            <stop offset="100%" stop-color="#fff" stop-opacity="0"/>
                        </linearGradient>
                    </defs>
                    <!-- Kepala -->
                    <circle cx="100" cy="100" r="48" fill="#f5d0a9" stroke="#d4a574" stroke-width="2"/>
                    <!-- Kacamata -->
                    <circle cx="80" cy="95" r="14" fill="none" stroke="#333" stroke-width="3"/>
                    <circle cx="120" cy="95" r="14" fill="none" stroke="#333" stroke-width="3"/>
                    <line x1="94" y1="95" x2="106" y2="95" stroke="#333" stroke-width="3"/>
                    <!-- Mata -->
                    <circle cx="80" cy="95" r="5" fill="#1a1a1a"/>
                    <circle cx="120" cy="95" r="5" fill="#1a1a1a"/>
                    <circle cx="82" cy="93" r="2" fill="#fff"/>
                    <circle cx="122" cy="93" r="2" fill="#fff"/>
                    <!-- Hidung -->
                    <ellipse cx="100" cy="108" rx="4" ry="3" fill="#d4a574"/>
                    <!-- Mulut -->
                    <path d="M88 118 Q100 130 112 118" fill="none" stroke="#8b5e3c" stroke-width="2.5" stroke-linecap="round"/>
                    <!-- Papan Nama -->
                    <rect x="45" y="185" width="110" height="30" rx="8" fill="#ffd700" stroke="#b8860b" stroke-width="2"/>
                    <text x="100" y="205" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="#0b2e1f" text-anchor="middle">AL-MANAR</text>
                    <!-- Tangan -->
                    <rect x="35" y="160" width="25" height="10" rx="5" fill="#f5d0a9" stroke="#d4a574" stroke-width="1.5" transform="rotate(-15 47 165)"/>
                    <rect x="140" y="160" width="25" height="10" rx="5" fill="#f5d0a9" stroke="#d4a574" stroke-width="1.5" transform="rotate(15 152 165)"/>
                </svg>
            </div>
            <div class="maskot-info" id="maskotInfo">
                <strong>Halo, saya Maskot AL-MANAR!</strong><br>
                Saya siap memberikan informasi seputar <span class="highlight">Pesantren Al-Madani Cikalong</span>.
                <br><br>
                📍 <strong>Lokasi:</strong> Desa Cikalong, Kec. Sukahaji, Kab. Majalengka, Jawa Barat.<br>
                🕌 <strong>Berdiri:</strong> 2016 (1 Ramadhan 1438 H).<br>
                🎓 <strong>Program Unggulan:</strong> Tahfizul Qur'an (minimal 8 juz), Bahasa Arab & Inggris, Ekstrakurikuler (Pencak Silat, Drumband, Jurnalis, Pramuka).<br>
                🏫 <strong>Status:</strong> Satuan Pendidikan Mu'adalah (setara formal, lulusan diakui perguruan tinggi).
            </div>
        </section>

        <!-- NAVIGASI -->
        <nav class="nav-bar">
            <button class="nav-btn active" onclick="switchTab('beranda')">🏠 Beranda</button>
            <button class="nav-btn" onclick="switchTab('operator')">⚙️ Panel Operator</button>
        </nav>

        <!-- ===== HALAMAN BERANDA ===== -->
        <div id="page-beranda">
            <h2 class="section-title">Artikel Terbaru</h2>
            <div class="artikel-grid" id="artikelGrid">
                <div class="empty-state" id="emptyState">
                    <div class="icon">📝</div>
                    <p>Belum ada artikel yang dipublikasikan.</p>
                    <small>Operator dapat menambahkan artikel melalui Panel Operator.</small>
                </div>
            </div>
        </div>

        <!-- ===== HALAMAN OPERATOR ===== -->
        <div id="page-operator" style="display:none;">
            <div class="operator-panel show" style="display:block;">
                <h2>⚙️ Panel Operator</h2>
                <p style="color:#8ab89a; font-size:0.85rem; margin-bottom:20px;">
                    Kelola artikel AL-MANAR. Tambahkan, edit, atau hapus artikel sesuai kebutuhan redaksi.
                </p>

                <div class="form-group">
                    <label>Judul Artikel</label>
                    <input type="text" id="inputJudul" placeholder="Masukkan judul artikel...">
                </div>

                <div class="form-group">
                    <label>Kategori</label>
                    <select id="inputKategori">
                        <option value="Berita Pesantren">Berita Pesantren</option>
                        <option value="Prestasi Santri">Prestasi Santri</option>
                        <option value="Kegiatan">Kegiatan</option>
                        <option value="Opini">Opini</option>
                        <option value="Wawancara">Wawancara</option>
                        <option value="Feature">Feature</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Penulis</label>
                    <input type="text" id="inputPenulis" placeholder="Nama penulis...">
                </div>

                <div class="form-group">
                    <label>Cuplikan / Ringkasan</label>
                    <textarea id="inputCuplikan" placeholder="Tulis ringkasan singkat artikel (1-2 kalimat)..."></textarea>
                </div>

                <div class="form-group">
                    <label>Isi Lengkap Artikel</label>
                    <textarea id="inputIsi" placeholder="Tulis isi lengkap artikel di sini..." style="min-height:180px;"></textarea>
                </div>

                <div class="btn-group">
                    <button class="btn-primary" onclick="tambahArtikel()">📤 Publikasikan Artikel</button>
                    <button class="btn-secondary" onclick="resetForm()">🔄 Reset Form</button>
                </div>

                <hr style="border-color:rgba(255,215,0,0.2); margin:30px 0;">

                <h3 style="color:#ffd700; font-size:1rem; margin-bottom:16px;">📋 Daftar Artikel Tersimpan</h3>
                <div id="daftarArtikelOperator">
                    <p style="color:#8ab89a; font-size:0.8rem;">Belum ada artikel.</p>
                </div>
            </div>
        </div>

        <!-- FOOTER -->
        <footer class="footer">
            <p>
                <span class="brand">AL-MANAR</span> — Jurnalistik Pesantren Al-Madani Cikalong<br>
                Desa Cikalong, Kec. Sukahaji, Kab. Majalengka, Jawa Barat<br>
                <span style="opacity:0.5;">© 2025 Bagian Jurnalistik Pesantren Al-Madani</span>
            </p>
        </footer>

